# /etc/studyagent/application.env on the shared LAN Linux host (10.0.3.117).
# root:studyagent 0640. Secrets are NOT stored here: the tripo-cli AIHUB keys
# (/etc/tripo/aihub.key, /etc/tripo/image.key) reach only the API process as
# systemd credentials (see studyagent-api.service and start-api.sh).
NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=14300
PORT=14300
WEB_PORT=13300
# Empty: the browser calls the same HTTPS origin; Next forwards /api to API_PORT (baked in at build time).
NEXT_PUBLIC_API_BASE_URL=
CORS_ORIGINS=https://10.0.3.117:8300,https://tripo.gz4399.com:8300
STUDY_TRUST_PROXY=127.0.0.1/32,::1/128
STUDY_STORAGE=sqlite
STUDY_DATA_DIR=/data/studyagent/var
STUDY_WORKER_ENABLED=true
STUDY_PYTHON=/data/studyagent/venv/bin/python
STUDY_PDF_PYTHON_COMMAND=/data/studyagent/venv/bin/python
STUDY_FFMPEG=/usr/bin/ffmpeg
STUDY_FFPROBE=/usr/bin/ffprobe
NEXT_TELEMETRY_DISABLED=1
# Generated once with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
# Public ChinaTextbook PDFs (byte-verified) and extracts rebuilt by restore-textbook-extracts.py
TEXTBOOK_BASE_PATH=/data/studyagent/ChinaTextbook
STUDY_ASSET_ROOT=/data/studyagent/assets

# Text models: AIHUB OpenAI-compatible endpoint with the tripo-cli key.
OPENAI_BASE_URL=https://aihub.gz4399.com/v1
OPENAI_MODEL=gpt-4.1-mini
CODEX_COMMAND=/data/studyagent/tools/codex/bin/codex
CODEX_HOME=/data/studyagent/codex-home
CODEX_MODEL=gpt-5.1
CODEX_PDF_MODEL=gpt-5.1
XIAOJIU_CHAT_ENABLED=true
XIAOJIU_CHAT_DEFAULT_MODEL=gpt-5.1
XIAOJIU_CHAT_TIMEOUT_MS=120000
XIAOJIU_MODEL_CATALOG=/data/studyagent/codex-home/models.json

# Classroom/teaching images: AIHUB gpt-image-2 with /etc/tripo/image.key.
STUDY_IMAGEGEN_SKILL_DIR=/data/studyagent/imagegen-skill
STUDY_IMAGE_PYTHON_COMMAND=/data/studyagent/imagegen-venv/bin/python
STUDY_IMAGE_BASE_URL=https://aihub.gz4399.com/v1

# Narration: local Kokoro Chinese TTS (studyagent-tts.service), OpenAI-compatible.
OPENAI_TTS_BASE_URL=http://127.0.0.1:14500/v1
OPENAI_TTS_MODEL=kokoro-v1.1-zh
OPENAI_TTS_VOICE=alloy
